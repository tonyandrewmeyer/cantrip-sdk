#!/usr/bin/bash
set -euo pipefail

mkdir -p /home/workshop/.config/cantrip
mkdir -p /home/workshop/.local/share/cantrip/uv-tools
mkdir -p /home/workshop/.local/bin
chown -R workshop:workshop \
    /home/workshop/.config/cantrip \
    /home/workshop/.local/share/cantrip \
    /home/workshop/.local/bin

# Install juju-cantrip pinned to the SDK's VERSION, but only if missing —
# subsequent workshop refreshes re-run this hook and we do not want to
# clobber a user's pinned or sideloaded install.
VERSION="$(cat "${SDK}/VERSION")"
if ! sudo -u workshop --login bash -c 'command -v cantrip >/dev/null 2>&1'; then
    sudo -u workshop --login \
        env "UV_TOOL_DIR=/home/workshop/.local/share/cantrip/uv-tools" \
            "UV_TOOL_BIN_DIR=/home/workshop/.local/bin" \
        "${SDK}/bin/uv" tool install --quiet "juju-cantrip==${VERSION}"
fi

# Conditionally write workshop-prompt.md — do not overwrite if user already has
# the same heading (idempotent across refreshes; lets users edit it).
PROMPT_TARGET=/home/workshop/.config/cantrip/workshop-prompt.md
if [[ ! -f "${PROMPT_TARGET}" ]]; then
    install -m 644 -o workshop -g workshop "${SDK}/workshop-prompt.md" "${PROMPT_TARGET}"
elif ! grep -Fq "$(head -1 "${SDK}/workshop-prompt.md")" "${PROMPT_TARGET}"; then
    printf '\n' >> "${PROMPT_TARGET}"
    cat "${SDK}/workshop-prompt.md" >> "${PROMPT_TARGET}"
fi
